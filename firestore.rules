rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read, owner-only write. Replace OWNER_EMAIL with your account email
    // (same value as VITE_OWNER_EMAIL in .env.local).
    match /lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "wwmacey@gmail.com";
    }
  }
}
